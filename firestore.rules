rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == "phaophonna.1@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 254 &&
             data.role in ['customer', 'admin'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['code', 'userId', 'userEmail', 'userName', 'destinationName', 'travelers', 'estimatedTotal', 'status']) &&
             data.code is string && data.code.size() <= 50 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 254 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.destinationName is string && data.destinationName.size() <= 150 &&
             data.travelers is number && data.travelers > 0 && data.travelers <= 100 &&
             data.estimatedTotal is number && data.estimatedTotal >= 0 &&
             data.status in ['pending', 'approved', 'paid', 'cancelled'];
    }

    function isValidDestination(data) {
      return data.keys().hasAll(['name', 'country', 'region', 'heroImage', 'priceFrom']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.country is string && data.country.size() > 0 && data.country.size() <= 100 &&
             data.region is string && data.region.size() > 0 && data.region.size() <= 100 &&
             data.heroImage is string && data.heroImage.size() <= 1000 &&
             data.priceFrom is number && data.priceFrom >= 0;
    }

    // User profiles & credentials
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      // Creating users: customers can create customer role, but ADMIN role can ONLY be created by super admin phaophonna.1@gmail.com
      allow create: if isValidUser(request.resource.data) && (
        (request.resource.data.role == 'customer') ||
        (request.resource.data.role == 'admin' && isSuperAdminEmail())
      );
      
      // Updates: user can update own profile, super admin can manage
      allow update: if (
        isAdmin() ||
        (isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data))
      );
      
      // DELETION RULE: phaophonna.1@gmail.com CANNOT BE DELETED BY ANYONE!
      // Other secondary admins can only be deleted by super admin phaophonna.1@gmail.com
      allow delete: if isSuperAdminEmail() && resource.data.email != "phaophonna.1@gmail.com";
    }

    // Admin Markers (managed exclusively by super admin phaophonna.1@gmail.com)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdminEmail();
      allow delete: if isSuperAdminEmail() && resource.data.email != "phaophonna.1@gmail.com";
    }

    // Verification Codes for OTP Email Verification & Self Password Reset
    match /verificationCodes/{codeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['email', 'code', 'purpose', 'expiresAt']) &&
                    request.resource.data.code.size() == 6;
      allow update, delete: if true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidBooking(request.resource.data);
      allow update: if isValidBooking(request.resource.data) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Custom Destinations
    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && (request.resource.data == null || isValidDestination(request.resource.data));
    }
  }
}
